# ===== LLM：火山方舟 Coding Plan（OpenAI 兼容接口，与 Claude Code 同模型）=====
LLM_MODEL_ID=ark-code-latest
LLM_API_KEY=your-ark-api-key
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v1
# 推理模型生成多日行程较慢，建议 300 秒
LLM_TIMEOUT=300

# ===== 高德地图 Web服务 Key（可选；不填走纯 LLM 知识规划）=====
# 申请：https://console.amap.com/dev/key/app （服务平台选「Web服务」）
AMAP_API_KEY=

# ===== Unsplash 配图（可选；不填自动降级无图）=====
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ===== 预算缓存（可选；不填/连不上自动降级进程内 TTL 缓存）=====
# 预算不入库，只走 Redis 短期 TTL（默认 db=1 与本机其他项目隔离）
REDIS_URL=redis://127.0.0.1:6379/1
BUDGET_CACHE_TTL_HOURS=24
